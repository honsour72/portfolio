    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "cheerio": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
