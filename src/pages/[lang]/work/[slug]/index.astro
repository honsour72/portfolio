---
import { casesByLocale, caseSlugs } from '../../../../content/cases';
import { locales } from '../../../../lib/i18n';
import type { CaseSlug, Locale } from '../../../../lib/types';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    caseSlugs.map((slug) => ({ params: { lang, slug } })),
  );
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as CaseSlug;
const content = casesByLocale[lang][slug];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={content.seo.description} />
    <title>{content.seo.title}</title>
  </head>
  <body>
    <main>
      <p>{content.label}</p>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </main>
  </body>
</html>
