---
import type { CaseStudy, Locale } from '../lib/types';

type Props = {
  locale: Locale;
  title: string;
  cases: CaseStudy[];
};

const { locale, title, cases } = Astro.props;
const readLabel = locale === 'en' ? 'Read the case' : 'Читать кейс';
---

<section id="work" class="section container selected-work" aria-labelledby="work-title">
  <div class="section-heading">
    <p class="section-number">01</p>
    <h2 id="work-title">{title}</h2>
  </div>
  <div class="work-stack">
    {cases.map((item, index) => (
      <article class:list={['work-feature', index === 1 && 'work-feature-dark']}>
        <div class="work-feature-copy">
          <p class="eyebrow">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.intro}</p>
          <dl class="work-details">
            {item.details.map((detail) => (
              <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
            ))}
          </dl>
          <a class="text-link" href={`/${locale}/work/${item.slug}/`}>{readLabel} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="work-visual" aria-hidden="true">
          <span class="work-index">0{index + 1}</span>
          <div class="signal-lines"><i></i><i></i><i></i><i></i></div>
          {item.metrics && <strong>{item.metrics[0]?.value}</strong>}
        </div>
      </article>
    ))}
  </div>
</section>
