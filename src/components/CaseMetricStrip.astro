---
import type { Metric } from '../lib/types';
type Props = { metrics: Metric[] };
const { metrics } = Astro.props;
---

<section class="case-metrics" aria-label="Case results">
  <div class="container case-metrics-grid">
    {metrics.map((metric) => (
      <div>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))}
  </div>
</section>
