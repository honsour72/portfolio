---
import type { Locale } from '../lib/types';
import { portfolioByLocale } from '../content/portfolio';
import CvMenu from './CvMenu.astro';
import MobileNavigation from './MobileNavigation.astro';

type Props = { locale: Locale; path: string };

const { locale, path } = Astro.props;
const content = portfolioByLocale[locale];
const localePath = (targetLocale: Locale) => path.replace(`/${locale}/`, `/${targetLocale}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={`/${locale}/`} aria-label={content.hero.name}>{content.hero.name.split(' ')[0]} R.</a>
    <nav class="primary-nav" aria-label={locale === 'en' ? 'Primary navigation' : 'Основная навигация'}>
      <a href={`/${locale}/#work`}>{content.navigation[0].label}</a>
      <a href={`/${locale}/#experience`}>{content.navigation[1].label}</a>
      <a href={`/${locale}/#writing`}>{content.navigation[3].label}</a>
      <a href={`/${locale}/#contact`}>{content.navigation[6].label}</a>
    </nav>
    <div class="header-actions">
      <MobileNavigation locale={locale} navigation={content.navigation} />
      <div class="locale-switch" aria-label={locale === 'en' ? 'Language' : 'Язык'}>
        {locale === 'en'
          ? <span aria-current="page">EN</span>
          : <a href={localePath('en')} lang="en">EN</a>}
        <span aria-hidden="true">/</span>
        {locale === 'ru'
          ? <span aria-current="page">RU</span>
          : <a href={localePath('ru')} lang="ru">RU</a>}
      </div>
      <CvMenu locale={locale} labels={content.cvMenu} />
    </div>
  </div>
</header>
